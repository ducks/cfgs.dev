[
  {
    "id": "terminal.wezterm",
    "name": "WezTerm",
    "category": "terminal",
    "patterns": ["**/.wezterm.lua", "**/wezterm/*.lua", "**/wezterm.lua"],
    "extract": {
      "font": "font\\s*=\\s*wezterm\\.font\\s*['\"](.+?)['\"]",
      "colorscheme": "color_scheme\\s*=\\s*['\"](.+?)['\"]"
    }
  },
  {
    "id": "terminal.alacritty",
    "name": "Alacritty",
    "category": "terminal",
    "patterns": [
      "**/.config/alacritty/alacritty.toml",
      "**/.config/alacritty/alacritty.yml",
      "**/alacritty/alacritty.toml",
      "**/alacritty.toml"
    ],
    "extractToml": {
      "font": "font.normal.family",
      "background": "colors.primary.background"
    }
  },
  {
    "id": "terminal.kitty",
    "name": "Kitty",
    "category": "terminal",
    "patterns": ["**/.config/kitty/kitty.conf", "**/kitty/kitty.conf", "**/kitty.conf"],
    "extract": {
      "font": "font_family\\s+(.+)",
      "theme": "include\\s+.*?([^/]+)\\.conf"
    }
  },
  {
    "id": "terminal.foot",
    "name": "Foot",
    "category": "terminal",
    "patterns": ["**/.config/foot/foot.ini", "**/foot/foot.ini", "**/foot.ini"],
    "extract": {
      "font": "font\\s*=\\s*(.+)",
      "shell": "shell\\s*=\\s*(.+)"
    }
  },
  {
    "id": "terminal.ghostty",
    "name": "Ghostty",
    "category": "terminal",
    "patterns": ["**/.config/ghostty/config", "**/ghostty/config"],
    "extract": {
      "font": "font-family\\s*=\\s*(.+)",
      "theme": "theme\\s*=\\s*(.+)"
    }
  },
  {
    "id": "terminal.st",
    "name": "st",
    "category": "terminal",
    "patterns": ["**/st/config.h", "**/st/config.def.h"],
    "extract": {
      "font": "font\\s*=\\s*\"(.+?)\""
    }
  }
]
