[
  {
    "id": "wm.hyprland",
    "name": "Hyprland",
    "category": "wm",
    "patterns": ["**/.config/hypr/hyprland.conf", "**/hypr/hyprland.conf", "**/hypr/*.conf"],
    "extract": {
      "terminal": "\\$terminal\\s*=\\s*(.+)",
      "launcher": "\\$launcher\\s*=\\s*(.+)"
    },
    "contentFlags": {
      "bar": [
        { "match": "waybar", "value": "waybar" },
        { "match": "polybar", "value": "polybar" }
      ],
      "notifications": [
        { "match": "dunst", "value": "dunst" },
        { "match": "mako", "value": "mako" }
      ]
    }
  },
  {
    "id": "wm.sway",
    "name": "Sway",
    "category": "wm",
    "patterns": ["**/.config/sway/config", "**/sway/config"],
    "contentFlags": {
      "bar": [
        { "match": "waybar", "value": "waybar" },
        { "match": "swaybar", "value": "swaybar" }
      ]
    }
  },
  {
    "id": "wm.i3",
    "name": "i3",
    "category": "wm",
    "patterns": ["**/.config/i3/config", "**/.i3/config", "**/i3/config"],
    "contentFlags": {
      "bar": [
        { "match": "polybar", "value": "polybar" },
        { "match": "i3bar", "value": "i3bar" },
        { "match": "bar {", "value": "i3bar" }
      ],
      "variant": [
        { "match": "gaps inner", "value": "i3-gaps" },
        { "match": "gaps outer", "value": "i3-gaps" }
      ]
    }
  },
  {
    "id": "wm.awesome",
    "name": "AwesomeWM",
    "category": "wm",
    "patterns": ["**/.config/awesome/rc.lua", "**/awesome/rc.lua", "**/awesome/*.lua"],
    "extract": {
      "theme": "beautiful\\.init.*?([^/]+)/theme"
    }
  },
  {
    "id": "wm.bspwm",
    "name": "bspwm",
    "category": "wm",
    "patterns": ["**/.config/bspwm/bspwmrc", "**/bspwm/bspwmrc"]
  },
  {
    "id": "wm.dwm",
    "name": "dwm",
    "category": "wm",
    "patterns": ["**/dwm/config.h", "**/dwm/config.def.h"],
    "extract": {
      "font": "font\\[\\]\\s*=\\s*\"(.+?)\""
    }
  },
  {
    "id": "wm.qtile",
    "name": "Qtile",
    "category": "wm",
    "patterns": ["**/.config/qtile/config.py", "**/qtile/config.py"]
  },
  {
    "id": "wm.xmonad",
    "name": "XMonad",
    "category": "wm",
    "patterns": ["**/.xmonad/xmonad.hs", "**/xmonad/xmonad.hs", "**/.config/xmonad/xmonad.hs"]
  },
  {
    "id": "wm.river",
    "name": "River",
    "category": "wm",
    "patterns": ["**/.config/river/init", "**/river/init"]
  },
  {
    "id": "wm.niri",
    "name": "Niri",
    "category": "wm",
    "patterns": ["**/.config/niri/config.kdl", "**/niri/config.kdl"]
  }
]
