[
  {
    "id": "prompt.starship",
    "name": "Starship",
    "category": "prompt",
    "patterns": ["**/.config/starship.toml", "**/starship/starship.toml", "**/starship.toml"]
  },
  {
    "id": "multiplexer.tmux",
    "name": "tmux",
    "category": "multiplexer",
    "patterns": ["**/.tmux.conf", "**/tmux/tmux.conf", "**/tmux.conf"],
    "extract": {
      "prefix": "set\\s+-g\\s+prefix\\s+(\\S+)"
    },
    "contentFlags": {
      "pluginManager": [
        { "match": "tpm", "value": "tpm" },
        { "match": "tmux-plugins", "value": "tpm" }
      ]
    }
  },
  {
    "id": "multiplexer.zellij",
    "name": "Zellij",
    "category": "multiplexer",
    "patterns": ["**/.config/zellij/config.kdl", "**/zellij/config.kdl"]
  },
  {
    "id": "bar.waybar",
    "name": "Waybar",
    "category": "bar",
    "patterns": [
      "**/.config/waybar/config",
      "**/.config/waybar/config.jsonc",
      "**/waybar/config",
      "**/waybar/config.jsonc"
    ],
    "contentFlags": {
      "position": [
        { "match": "\"position\": \"top\"", "value": "top" },
        { "match": "\"position\":\"top\"", "value": "top" },
        { "match": "\"position\": \"bottom\"", "value": "bottom" }
      ]
    }
  },
  {
    "id": "bar.polybar",
    "name": "Polybar",
    "category": "bar",
    "patterns": [
      "**/.config/polybar/config",
      "**/.config/polybar/config.ini",
      "**/polybar/config",
      "**/polybar/config.ini"
    ]
  },
  {
    "id": "launcher.rofi",
    "name": "Rofi",
    "category": "launcher",
    "patterns": ["**/.config/rofi/config.rasi", "**/rofi/config.rasi", "**/rofi/*.rasi"],
    "extract": {
      "theme": "@theme\\s+\"([^\"]+)\""
    }
  },
  {
    "id": "launcher.wofi",
    "name": "Wofi",
    "category": "launcher",
    "patterns": ["**/.config/wofi/config", "**/.config/wofi/style.css", "**/wofi/config", "**/wofi/style.css"]
  },
  {
    "id": "notifications.dunst",
    "name": "Dunst",
    "category": "notifications",
    "patterns": ["**/.config/dunst/dunstrc", "**/dunst/dunstrc"]
  },
  {
    "id": "tool.git",
    "name": "Git",
    "category": "vcs",
    "patterns": ["**/.gitconfig", "**/git/config", "**/gitconfig"],
    "extract": {
      "editor": "editor\\s*=\\s*(.+)",
      "defaultBranch": "defaultBranch\\s*=\\s*(.+)"
    }
  },
  {
    "id": "bar.eww",
    "name": "Eww",
    "category": "bar",
    "patterns": ["**/.config/eww/eww.yuck", "**/eww/eww.yuck", "**/eww/*.yuck"]
  },
  {
    "id": "bar.ags",
    "name": "AGS",
    "category": "bar",
    "patterns": ["**/.config/ags/config.js", "**/ags/config.js", "**/ags/*.js"]
  },
  {
    "id": "launcher.dmenu",
    "name": "dmenu",
    "category": "launcher",
    "patterns": ["**/dmenu/config.h", "**/dmenu/config.def.h"]
  },
  {
    "id": "launcher.fuzzel",
    "name": "Fuzzel",
    "category": "launcher",
    "patterns": ["**/.config/fuzzel/fuzzel.ini", "**/fuzzel/fuzzel.ini"]
  },
  {
    "id": "launcher.tofi",
    "name": "Tofi",
    "category": "launcher",
    "patterns": ["**/.config/tofi/config", "**/tofi/config"]
  },
  {
    "id": "compositor.picom",
    "name": "Picom",
    "category": "compositor",
    "patterns": ["**/.config/picom/picom.conf", "**/picom/picom.conf", "**/picom.conf"]
  },
  {
    "id": "filemanager.ranger",
    "name": "Ranger",
    "category": "filemanager",
    "patterns": ["**/.config/ranger/rc.conf", "**/ranger/rc.conf"]
  },
  {
    "id": "filemanager.lf",
    "name": "lf",
    "category": "filemanager",
    "patterns": ["**/.config/lf/lfrc", "**/lf/lfrc"]
  },
  {
    "id": "filemanager.yazi",
    "name": "Yazi",
    "category": "filemanager",
    "patterns": ["**/.config/yazi/yazi.toml", "**/yazi/yazi.toml"],
    "extractToml": {
      "theme": "theme"
    }
  },
  {
    "id": "tool.lazygit",
    "name": "Lazygit",
    "category": "tool",
    "patterns": ["**/.config/lazygit/config.yml", "**/lazygit/config.yml"]
  },
  {
    "id": "tool.atuin",
    "name": "Atuin",
    "category": "tool",
    "patterns": ["**/.config/atuin/config.toml", "**/atuin/config.toml"]
  },
  {
    "id": "tool.direnv",
    "name": "direnv",
    "category": "tool",
    "patterns": ["**/.direnvrc", "**/direnv/direnvrc"]
  },
  {
    "id": "tool.zoxide",
    "name": "Zoxide",
    "category": "tool",
    "patterns": ["**/.config/zoxide/config.toml", "**/zoxide.toml"]
  },
  {
    "id": "tool.fzf",
    "name": "fzf",
    "category": "tool",
    "patterns": ["**/.fzf.bash", "**/.fzf.zsh", "**/fzf/*.zsh"]
  },
  {
    "id": "notifications.mako",
    "name": "Mako",
    "category": "notifications",
    "patterns": ["**/.config/mako/config", "**/mako/config"]
  },
  {
    "id": "tool.dotter",
    "name": "Dotter",
    "category": "tool",
    "patterns": ["**/.dotter/global.toml", "**/dotter/global.toml", "**/.dotter.toml"]
  },
  {
    "id": "tool.chezmoi",
    "name": "Chezmoi",
    "category": "tool",
    "patterns": ["**/.chezmoi.toml", "**/.chezmoiroot", "**/chezmoi/*.toml"]
  },
  {
    "id": "tool.stow",
    "name": "GNU Stow",
    "category": "tool",
    "patterns": ["**/.stow-local-ignore", "**/.stowrc"]
  }
]
